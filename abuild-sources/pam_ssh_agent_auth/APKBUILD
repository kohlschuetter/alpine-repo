# Contributor: Christian Kohlschütter <christian@kohlschutter.com>
# Maintainer:
pkgname=pam_ssh_agent_auth
pkgver=0.10.4
pkgrel=1
pkgdesc="PAM module which permits PAM authentication via your keyring in a forwarded ssh-agent"
url="https://github.com/jbeverly/pam_ssh_agent_auth"
arch="all"
license="OpenSSL"
depends=""
makedepends="linux-pam-dev openssl-dev perl"
install=""
subpackages="$pkgname-doc"
source="https://github.com/jbeverly/pam_ssh_agent_auth/archive/pam_ssh_agent_auth-0.10.4.tar.gz
https://github.com/floodyberry/ed25519-donna/archive/8757bd4cd209cb032853ece0ce413f122eef212c.zip
sys-types.patch
configure.patch
"

builddir="$srcdir/${pkgname}-${pkgname}-${pkgver}"

build() {
    rm -rf ed25519-donna
    ln -s ../ed25519-donna-8757bd4cd209cb032853ece0ce413f122eef212c ed25519-donna

    CFLAGS="-DHAVE___PROGNAME=1 -Wno-incompatible-pointer-types" ./configure \
		--build=${CBUILD%-musl} \
		--host=${CHOST%-musl} \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--libexecdir=/usr/lib/security \
		--with-mantype=man \
		--without-openssl-header-check

	make
}

package() {
	mkdir -p "$pkgdir/usr/share/doc/$pkgname"
	cp CONTRIBUTORS LICENSE.OpenSSL OPENSSH_LICENSE README "$pkgdir/usr/share/doc/$pkgname"
 
	make DESTDIR="$pkgdir" install
}

